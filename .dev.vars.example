# Active entries become secret inputs in the Deploy-to-Cloudflare form.
# Ordinary settings, including CLOUDFLARE_ACCOUNT_ID, belong in wrangler.jsonc vars.
CLOUDFLARE_API_TOKEN=your_read_only_api_token

# Required for POST /v1/events/ci and POST /v1/test.
INGEST_SHARED_SECRET=replace_me

# Optional secrets: uncomment only the features you use in your local .dev.vars.
# For hosted installations, add these under Worker Settings > Variables and Secrets.
# Configure at least one destination before checking /readyz or sending events.
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE_THREAD_ID=
# GENERIC_WEBHOOK_URL=
# GENERIC_WEBHOOK_SECRET=

# Only needed for Cloudflare Pages generic webhook notifications.
# PAGES_WEBHOOK_SECRET=
