# Cloudflare API access used by Pages polling and optional Workers reconciliation.
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_read_only_api_token

# Required for POST /v1/events/ci and POST /v1/test.
INGEST_SHARED_SECRET=replace_me

# Required only if using Cloudflare Pages generic webhook notifications.
PAGES_WEBHOOK_SECRET=replace_me

# Configure one or more destinations.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_SECRET=

# Override wrangler vars locally if desired.
PROJECTS_JSON=[{"product":"pages","name":"example-pages","branchEnvironmentMap":{"main":"production","staging":"staging"}},{"product":"workers","name":"example-worker","environment":"production","reconcile":false}]
NOTIFY_STARTED=true
NOTIFY_ON_BOOTSTRAP=false
ERROR_SUMMARY_MAX_CHARS=1200
STATE_TTL_SECONDS=2592000
